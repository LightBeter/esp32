menu "Application"

choice DEVICE_MODEL
    prompt "Device Model"
    default DEVICE_MODEL_LM25
    config DEVICE_MODEL_LB150
        bool "LB150"
    config DEVICE_MODEL_LM25
        bool "LM25"
    config DEVICE_MODEL_LM15
        bool "LM15"
    config DEVICE_MODEL_LM30
        bool "LM30"
endchoice

 choice COMPILE_MODEL
    bool "compile model"
    default COMPILE_MODEL_DEBUG
    config COMPILE_MODEL_DEBUG
        bool "compile debug version"
    config COMPILE_MODEL_RELEASE
        bool "compile release version"
        select SECURE_BOOT
        select SECURE_FLASH_ENC_ENABLED
endchoice

endmenu                             