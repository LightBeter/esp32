# Enable C++ exceptions 
CONFIG_COMPILER_CXX_EXCEPTIONS=n
# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Default sdkconfig parameters to use the OTA
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x16000
CONFIG_PARTITION_TABLE_MD5=y
/* Bootloader */
CONFIG_BOOTLOADER_FACTORY_RESET=n
CONFIG_BOOTLOADER_DATA_FACTORY_RESET="nvs,phy_init,otadata,storage"
CONFIG_BOOTLOADER_OTA_DATA_ERASE=y
CONFIG_BOOTLOADER_NUM_PIN_FACTORY_RESET=21
/* Secure */
//CONFIG_SECURE_BOOT=y
//CONFIG_SECURE_BOOT_SIGNIG_KEY="secure_boot_signing_key.pem"
//CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
//CONFIG_SECURE_FLASH_ENC_ENABLED=y
/* */
CONFIG_ESP_NETIF_TCPIP_ADAPTER_COMPATIBLE_LAYER=y
/* WebSocket Server */
CONFIG_WEBSOCKET_SERVER_TASK_STACK_DEPTH=6144
CONFIG_WEBSOCKET_SERVER_MAX_CLIENTS=6
CONFIG_WEBSOCKET_SERVER_QUEUE_SIZE=20
